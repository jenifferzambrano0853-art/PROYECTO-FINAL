<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jeniffer Zambrano — Perfil académico</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F5F8FC;
    --paper-2:#E8F0FA;
    --ink:#0F2A47;
    --ink-soft:#4C6478;
    --teal:#1B5FC4;
    --teal-dark:#0F3E85;
    --brass:#3B82C7;
    --line:#D6E3F2;
    --white:#FFFFFF;
    --radius:14px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }

  body{
    margin:0;
    background:var(--paper);
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 42px 42px;
    background-position:-1px -1px;
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    line-height:1.6;
  }

  .wrap{
    max-width:920px;
    margin:0 auto;
    padding:0 24px;
  }

  /* ---------- HEADER ---------- */
  header.hero{
    padding:64px 0 40px;
    animation:riseIn .7s ease both;
  }
  @keyframes riseIn{
    from{opacity:0; transform:translateY(10px);}
    to{opacity:1; transform:translateY(0);}
  }
  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:13px;
    letter-spacing:.08em;
    color:var(--teal-dark);
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:18px;
  }
  .eyebrow::before{
    content:"";
    width:22px;
    height:1px;
    background:var(--teal);
    display:inline-block;
  }
  h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(34px, 6vw, 56px);
    line-height:1.05;
    margin:0 0 20px;
    letter-spacing:-0.01em;
  }
  .bio{
    max-width:62ch;
    font-size:17px;
    color:var(--ink-soft);
  }
  .bio strong{color:var(--ink); font-weight:600;}

  /* ---------- CREDENCIAL (foto + universidad, unidos) ---------- */
  section.credential{
    margin:36px 0 64px;
  }
  .card{
    background:var(--white);
    border:1px solid var(--line);
    border-radius:var(--radius);
    box-shadow:0 1px 2px rgba(28,35,33,0.04), 0 12px 28px -18px rgba(28,35,33,0.25);
    overflow:hidden;
    display:grid;
    grid-template-columns: 220px 1fr;
  }
  @media (max-width:640px){
    .card{grid-template-columns:1fr;}
  }

  .photo-cell{
    background:
      repeating-linear-gradient(135deg, var(--paper-2) 0 10px, var(--paper) 10px 20px);
    border-right:1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:28px;
    position:relative;
  }
  @media (max-width:640px){
    .photo-cell{border-right:none; border-bottom:1px solid var(--line);}
  }
  .photo-frame{
    width:150px;
    height:150px;
    border-radius:50%;
    background:var(--white);
    border:2px dashed var(--brass);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    overflow:hidden;
  }
  .photo-frame img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }
  .photo-frame .placeholder-text{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--brass);
    padding:0 12px;
    line-height:1.4;
  }
  .photo-frame .monogram{
    font-family:'Fraunces', serif;
    font-size:30px;
    color:var(--teal-dark);
    font-weight:600;
    margin-bottom:4px;
  }

  .info-cell{
    padding:28px 30px;
  }
  .info-cell .uni-name{
    font-family:'Fraunces', serif;
    font-size:22px;
    font-weight:600;
    color:var(--teal-dark);
    margin:0 0 4px;
  }
  .info-cell .seal-tag{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--ink-soft);
    margin:0 0 18px;
  }
  dl.data-grid{
    display:grid;
    grid-template-columns:auto 1fr;
    gap:8px 18px;
    margin:0;
  }
  dl.data-grid dt{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    color:var(--teal);
    text-transform:uppercase;
    letter-spacing:.03em;
    white-space:nowrap;
    padding-top:2px;
  }
  dl.data-grid dd{
    margin:0;
    font-size:15px;
    color:var(--ink);
    font-weight:500;
  }

  /* ---------- UNIDADES NAV ---------- */
  section.units{
    padding-bottom:80px;
  }
  .units-heading{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:18px;
  }
  .units-heading h2{
    font-family:'Fraunces', serif;
    font-size:26px;
    margin:0;
    font-weight:600;
  }
  .units-heading .sub{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    color:var(--ink-soft);
  }

  .tabs{
    display:flex;
    gap:2px;
    border-bottom:1px solid var(--line);
    margin-bottom:0;
    flex-wrap:wrap;
    position:relative;
  }
  .tab-btn{
    font-family:'IBM Plex Mono', monospace;
    font-size:14px;
    background:var(--paper-2);
    border:1px solid var(--line);
    border-bottom:none;
    border-radius:10px 10px 0 0;
    padding:12px 20px;
    color:var(--ink-soft);
    cursor:pointer;
    position:relative;
    top:1px;
    transition:background .25s ease, color .25s ease, transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s ease;
  }
  .tab-btn::before{
    content:"# ";
    color:var(--teal);
    transition:transform .25s ease;
    display:inline-block;
  }
  .tab-btn:hover{
    color:var(--ink);
    transform:translateY(-4px);
    box-shadow:0 8px 16px -8px rgba(27,95,196,0.35);
  }
  .tab-btn:hover::before{
    transform:rotate(-12deg) scale(1.15);
  }
  .tab-btn:active{
    transform:translateY(-1px) scale(.97);
  }
  .tab-btn:focus-visible{
    outline:2px solid var(--teal);
    outline-offset:2px;
  }
  .tab-btn[aria-selected="true"]{
    background:var(--white);
    color:var(--teal-dark);
    border-bottom:1px solid var(--white);
    font-weight:600;
  }
  .tab-indicator{
    position:absolute;
    bottom:-1px;
    height:2px;
    background:var(--teal);
    border-radius:2px;
    transition:left .35s cubic-bezier(.65,0,.35,1), width .35s cubic-bezier(.65,0,.35,1);
  }

  .panels{
    background:var(--white);
    border:1px solid var(--line);
    border-top:none;
    border-radius:0 0 var(--radius) var(--radius);
    padding:34px 32px;
    min-height:180px;
    overflow:hidden;
  }
  .panel{display:none;}
  .panel[aria-hidden="false"]{display:block; animation:panelIn .45s cubic-bezier(.22,1,.36,1) both;}
  @keyframes panelIn{
    from{opacity:0; transform:translateX(18px);}
    to{opacity:1; transform:translateX(0);}
  }
  .panel h3{
    transition:color .2s ease;
  }
  .pending{
    transition:transform .2s ease, box-shadow .2s ease;
  }
  .pending:hover{
    transform:translateY(-2px);
    box-shadow:0 6px 14px -8px rgba(59,130,199,0.5);
  }
  .panel h3{
    font-family:'Fraunces', serif;
    font-size:22px;
    margin:0 0 12px;
  }
  .panel p{
    color:var(--ink-soft);
    font-size:15px;
    max-width:60ch;
  }
  .pending{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    color:var(--brass);
    display:inline-flex;
    align-items:center;
    gap:8px;
    margin-top:10px;
    padding:8px 12px;
    background:#EAF2FC;
    border:1px dashed var(--brass);
    border-radius:8px;
  }

  footer{
    padding:28px 0 56px;
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--ink-soft);
    border-top:1px solid var(--line);
    text-align:center;
  }
</style>
</head>
<body>

<div class="wrap">

  <header class="hero">
    <p class="eyebrow">perfil académico</p>
    <h1>Jeniffer Zambrano</h1>
    <p class="bio">
      Actualmente continúo mi formación en la <strong>Universidad Técnica de Cotopaxi</strong>, en la carrera de
      <strong>Ingeniería en Software</strong>, construyendo las bases de programación y algoritmia que sostienen
      todo lo que vendrá después. <!-- Puedes editar este párrafo con tu historia personal -->
    </p>
  </header>

  <section class="credential">
    <div class="card">
      <div class="photo-cell">
        <div class="photo-frame">
          <!-- Reemplaza esta línea con tu foto real, por ejemplo: -->
          <!-- <img src="tu-foto.jpg" alt="Foto de Jeniffer Zambrano"> -->
          <span class="monogram">JZ</span>
          <span class="placeholder-text">Coloca aquí<br>tu fotografía</span>
        </div>
      </div>
      <div class="info-cell">
        <p class="uni-name">Universidad Técnica de Cotopaxi</p>
        <p class="seal-tag">// datos académicos del curso</p>
        <dl class="data-grid">
          <dt>Facultad</dt>
          <dd>Ciencias de las Ingenierías y Aplicadas</dd>
          <dt>Carrera</dt>
          <dd>Ingeniería en Software</dd>
          <dt>Nivel</dt>
          <dd>Nivelación</dd> <!-- Cambia aquí si es otro nivel -->
          <dt>Asignatura</dt>
          <dd>Programación y Algoritmia</dd> <!-- Cambia aquí si es otra asignatura -->
          <dt>Profesor</dt>
          <dd>Ing. René Quisaguano</dd> <!-- Cambia aquí por tu profesor -->
        </dl>
      </div>
    </div>
  </section>

  <section class="units">
    <div class="units-heading">
      <h2>Unidades de estudio</h2>
      <span class="sub">programación y algoritmia — índice de contenidos</span>
    </div>

    <div class="tabs" role="tablist" aria-label="Unidades del curso">
      <button class="tab-btn" role="tab" id="tab-1" aria-controls="panel-1" aria-selected="true" data-target="1">unidad-1</button>
      <button class="tab-btn" role="tab" id="tab-2" aria-controls="panel-2" aria-selected="false" data-target="2">unidad-2</button>
      <button class="tab-btn" role="tab" id="tab-3" aria-controls="panel-3" aria-selected="false" data-target="3">unidad-3</button>
      <span class="tab-indicator" id="tab-indicator"></span>
    </div>

    <div class="panels">
      <div class="panel" id="panel-1" role="tabpanel" aria-labelledby="tab-1" aria-hidden="false">
        <h3>Unidad 1</h3>
        <p>Este espacio está listo para el contenido de la primera unidad.</p>
        <span class="pending">⏳ contenido pendiente por agregar</span>
      </div>
      <div class="panel" id="panel-2" role="tabpanel" aria-labelledby="tab-2" aria-hidden="true">
        <h3>Unidad 2</h3>
        <p>Este espacio está listo para el contenido de la segunda unidad.</p>
        <span class="pending">⏳ contenido pendiente por agregar</span>
      </div>
      <div class="panel" id="panel-3" role="tabpanel" aria-labelledby="tab-3" aria-hidden="true">
        <h3>Unidad 3</h3>
        <p>Este espacio está listo para el contenido de la tercera unidad.</p>
        <span class="pending">⏳ contenido pendiente por agregar</span>
      </div>
    </div>
  </section>

  <footer>
    Jeniffer Zambrano — Ingeniería en Software — Universidad Técnica de Cotopaxi
  </footer>

</div>

<script>
  const tabs = document.querySelectorAll('.tab-btn');
  const panels = document.querySelectorAll('.panel');
  const indicator = document.getElementById('tab-indicator');

  function moveIndicator(tab){
    indicator.style.left = tab.offsetLeft + 'px';
    indicator.style.width = tab.offsetWidth + 'px';
  }

  window.addEventListener('load', () => moveIndicator(document.querySelector('.tab-btn[aria-selected="true"]')));
  window.addEventListener('resize', () => moveIndicator(document.querySelector('.tab-btn[aria-selected="true"]')));

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.target;

      tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
      tab.setAttribute('aria-selected', 'true');
      moveIndicator(tab);

      panels.forEach(p => p.setAttribute('aria-hidden', 'true'));
      document.getElementById('panel-' + target).setAttribute('aria-hidden', 'false');
    });

    tab.addEventListener('keydown', (e) => {
      const tabArray = Array.from(tabs);
      const index = tabArray.indexOf(tab);
      if(e.key === 'ArrowRight'){
        tabArray[(index + 1) % tabArray.length].focus();
        tabArray[(index + 1) % tabArray.length].click();
      }
      if(e.key === 'ArrowLeft'){
        tabArray[(index - 1 + tabArray.length) % tabArray.length].focus();
        tabArray[(index - 1 + tabArray.length) % tabArray.length].click();
      }
    });
  });
</script>

</body>
</html>
