<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Programación Básica y Algoritmia</title>
  <!-- Importar fuente Poppins desde Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Poppins', sans-serif;
      background-color: #e6d6f5;
      color: #3b2f4a;
      margin: 0;
      padding: 0;
    }
    header {
      background: #b38cd9;
      color: white;
      text-align: center;
      padding: 20px;
      font-size: 2em;
      font-weight: bold;
      letter-spacing: 2px;
    }
    .unidad, .tema {
      margin: 15px;
      border-radius: 10px;
      background: #f5f0fa;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      overflow: hidden; /* para respetar bordes redondeados */
    }
    .unidad h2, .tema h3 {
      background: #c9a7eb;
      margin: 0;
      padding: 12px 18px;
      cursor: pointer;
      border-radius: 10px 10px 0 0;
      user-select: none;
      transition: background 0.2s;
    }
    .unidad h2:hover, .tema h3:hover {
      background: #b38cd9;
    }
    .contenido, .detalle {
      display: none;
      padding: 15px;
      line-height: 1.6;
    }
    .contenido.mostrar, .detalle.mostrar {
      display: block;
    }
    .ejemplo, .ejercicio {
      background: #ede3f7;
      padding: 10px 15px;
      border-left: 4px solid #b38cd9;
      margin-top: 5px;
      border-radius: 0 8px 8px 0;
    }
    .ejercicio input {
      margin: 5px 5px 5px 0;
      padding: 8px 12px;
      border-radius: 5px;
      border: 1px solid #b38cd9;
      font-family: inherit;
    }
    button {
      background: #b38cd9;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 5px;
      cursor: pointer;
      font-family: inherit;
      font-weight: 600;
      transition: background 0.2s;
    }
    button:hover {
      background: #6a4c93;
    }
    .cuestionario {
      margin-top: 10px;
    }
    .cuestionario p {
      margin: 8px 0 2px;
      font-weight: 600;
    }
    .cuestionario label {
      display: block;
      margin: 2px 0 2px 20px;
      font-weight: 400;
    }
    .resultado {
      margin-top: 10px;
      font-weight: bold;
      padding: 8px;
      background: #d9c9ed;
      border-radius: 5px;
      display: inline-block;
    }
    footer {
      text-align: center;
      padding: 15px;
      background: #b38cd9;
      color: white;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <header>📚 Programación Básica y Algoritmia</header>

  <!-- ==================== UNIDAD 1 ==================== -->
  <div class="unidad">
    <h2 onclick="toggle(this)">Unidad 1: Estructura y Funcionamiento del Computador</h2>
    <div class="contenido">
      <!-- Tema 1.1 -->
      <div class="tema">
        <h3 onclick="toggle(this)">Modelo de Von Neumann y Harvard</h3>
        <div class="detalle">
          <p><strong>Von Neumann:</strong> misma memoria para datos e instrucciones (cuello de botella).</p>
          <p><strong>Harvard:</strong> memorias separadas para datos e instrucciones, permite acceso simultáneo.</p>
        </div>
      </div>
      <!-- Tema 1.2 -->
      <div class="tema">
        <h3 onclick="toggle(this)">Sistemas Operativos</h3>
        <div class="detalle">
          <p>Software que gestiona el hardware, proporciona servicios a las aplicaciones y actúa como intermediario entre el usuario y la máquina.</p>
        </div>
      </div>
      <!-- Tema 1.3 -->
      <div class="tema">
        <h3 onclick="toggle(this)">Sistemas de Numeración</h3>
        <div class="detalle">
          <p>Binario (base 2), octal (base 8) y hexadecimal (base 16). Son fundamentales en computación.</p>
          <div class="ejercicio">
            <input type="number" id="decimalInput" placeholder="Número decimal">
            <button onclick="convertirBinario()">Convertir a Binario</button>
            <p id="resultadoBinario" class="resultado"></p>
          </div>
        </div>
      </div>
      <!-- Tema 1.4 -->
      <div class="tema">
        <h3 onclick="toggle(this)">Aritmética Binaria</h3>
        <div class="detalle">
          <p>Suma, resta, multiplicación y división en base 2. Ejemplo: 101 + 11 = 1000.</p>
        </div>
      </div>
      <!-- Tema 1.5 -->
      <div class="tema">
        <h3 onclick="toggle(this)">Álgebra de Boole</h3>
        <div class="detalle">
          <p>Operaciones lógicas (AND, OR, NOT). Leyes como absorción: A + A·B = A.</p>
          <div class="ejercicio">
            <button onclick="simplificar()">Simplificar A + A·B</button>
            <p id="resultadoSimplificacion" class="resultado"></p>
          </div>
        </div>
      </div>
      <!-- Cuestionario Unidad 1 -->
      <div class="tema">
        <h3 onclick="toggle(this)">Cuestionario Unidad 1</h3>
        <div class="detalle">
          <form id="quizU1" class="cuestionario">
            <p>1. ¿Qué arquitectura usa la misma memoria para datos e instrucciones?</p>
            <label><input type="radio" name="q1" value="correcto"> Von Neumann</label>
            <label><input type="radio" name="q1" value="incorrecto"> Harvard</label>

            <p>2. ¿Qué sistema de numeración utiliza solo 0 y 1?</p>
            <label><input type="radio" name="q2" value="correcto"> Binario</label>
            <label><input type="radio" name="q2" value="incorrecto"> Decimal</label>

            <p>3. ¿Cuál es el resultado de 101 + 11 en binario?</p>
            <label><input type="radio" name="q3" value="correcto"> 1000</label>
            <label><input type="radio" name="q3" value="incorrecto"> 1110</label>

            <p>4. ¿Qué simplificación corresponde a A + A·B?</p>
            <label><input type="radio" name="q4" value="correcto"> A</label>
            <label><input type="radio" name="q4" value="incorrecto"> A·B</label>

            <br><button type="button" onclick="calificar('quizU1','resultadoU1',4)">Calificar</button>
            <p id="resultadoU1" class="resultado"></p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== UNIDAD 2 ==================== -->
  <div class="unidad">
    <h2 onclick="toggle(this)">Unidad 2: Algoritmos, Diagramas de Flujo y Pseudocódigo</h2>
    <div class="contenido">
      <div class="tema">
        <h3 onclick="toggle(this)">Algoritmos</h3>
        <div class="detalle">
          <p>Conjunto finito de pasos ordenados y no ambiguos que resuelven un problema.</p>
        </div>
      </div>
      <div class="tema">
        <h3 onclick="toggle(this)">Diagramas de Flujo</h3>
        <div class="detalle">
          <p>Representación gráfica de un algoritmo usando figuras geométricas (rectángulos, rombos, etc.).</p>
        </div>
      </div>
      <div class="tema">
        <h3 onclick="toggle(this)">Pseudocódigo</h3>
        <div class="detalle">
          <p>Descripción textual de un algoritmo usando un lenguaje cercano al natural, sin sintaxis de un lenguaje específico.</p>
        </div>
      </div>
      <div class="tema">
        <h3 onclick="toggle(this)">Modelado de Problemas</h3>
        <div class="detalle">
          <p>Transformar una situación real en un algoritmo: identificar entradas, procesos y salidas.</p>
        </div>
      </div>
      <!-- Cuestionario Unidad 2 -->
      <div class="tema">
        <h3 onclick="toggle(this)">Cuestionario Unidad 2</h3>
        <div class="detalle">
          <form id="quizU2" class="cuestionario">
            <p>1. ¿Qué es un algoritmo?</p>
            <label><input type="radio" name="q5" value="correcto"> Conjunto de pasos ordenados</label>
            <label><input type="radio" name="q5" value="incorrecto"> Un lenguaje de programación</label>

            <p>2. ¿Qué herramienta gráfica representa algoritmos?</p>
            <label><input type="radio" name="q6" value="correcto"> Diagrama de flujo</label>
            <label><input type="radio" name="q6" value="incorrecto"> Mapa conceptual</label>

            <p>3. ¿Qué ventaja tiene el pseudocódigo?</p>
            <label><input type="radio" name="q7" value="correcto"> Es fácil de entender</label>
            <label><input type="radio" name="q7" value="incorrecto"> Solo funciona en Python</label>

            <p>4. ¿Qué símbolo se usa en diagramas de flujo para decisiones?</p>
            <label><input type="radio" name="q8" value="correcto"> Rombo</label>
            <label><input type="radio" name="q8" value="incorrecto"> Rectángulo</label>

            <p>5. ¿Qué significa modelar un problema?</p>
            <label><input type="radio" name="q9" value="correcto"> Representar una situación real en pasos lógicos</label>
            <label><input type="radio" name="q9" value="incorrecto"> Dibujar un mapa conceptual</label>

            <br><button type="button" onclick="calificar('quizU2','resultadoU2',5)">Calificar</button>
            <p id="resultadoU2" class="resultado"></p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== UNIDAD 3 ==================== -->
  <div class="unidad">
    <h2 onclick="toggle(this)">Unidad 3: Programación</h2>
    <div class="contenido">
      <div class="tema">
        <h3 onclick="toggle(this)">Lenguajes y Paradigmas</h3>
        <div class="detalle">
          <p>Paradigmas principales: imperativo (secuencial), orientado a objetos, funcional y lógico. Cada uno tiene su enfoque y ventajas.</p>
        </div>
      </div>
      <div class="tema">
        <h3 onclick="toggle(this)">Estructuras de Control</h3>
        <div class="detalle">
          <p>Condicionales (if-else), bucles (for, while) y saltos (break, continue).</p>
        </div>
      </div>
      <div class="tema">
        <h3 onclick="toggle(this)">Funciones y Procedimientos</h3>
        <div class="detalle">
          <p>Bloques de código reutilizables que reciben parámetros y pueden devolver valores.</p>
        </div>
      </div>
      <!-- Cuestionario Unidad 3 -->
      <div class="tema">
        <h3 onclick="toggle(this)">Cuestionario Unidad 3</h3>
        <div class="detalle">
          <form id="quizU3" class="cuestionario">
            <p>1. ¿Qué paradigma se basa en objetos que contienen datos y métodos?</p>
            <label><input type="radio" name="q10" value="correcto"> Orientado a objetos</label>
            <label><input type="radio" name="q10" value="incorrecto"> Funcional</label>

            <p>2. ¿Cuál es la estructura de control que ejecuta un bloque mientras se cumple una condición?</p>
            <label><input type="radio" name="q11" value="correcto"> Bucle while</label>
            <label><input type="radio" name="q11" value="incorrecto"> Condicional if</label>

            <p>3. ¿Qué permite reutilizar código en diferentes partes de un programa?</p>
            <label><input type="radio" name="q12" value="correcto"> Funciones</label>
            <label><input type="radio" name="q12" value="incorrecto"> Variables</label>

            <br><button type="button" onclick="calificar('quizU3','resultadoU3',3)">Calificar</button>
            <p id="resultadoU3" class="resultado"></p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <footer>
    © 2026 - Material didáctico para Programación Básica y Algoritmia
  </footer>

  <!-- ==================== SCRIPTS ==================== -->
  <script>
    // Función para desplegar/colapsar secciones
    function toggle(element) {
      // El siguiente elemento hermano es el contenedor que se muestra/oculta
      var target = element.nextElementSibling;
      if (target) {
        target.classList.toggle('mostrar');
      }
    }

    // Conversor decimal -> binario
    function convertirBinario() {
      var input = document.getElementById('decimalInput');
      var resultado = document.getElementById('resultadoBinario');
      var num = parseInt(input.value);
      if (isNaN(num) || num < 0) {
        resultado.textContent = 'Por favor, ingresa un número entero positivo.';
        return;
      }
      resultado.textContent = 'Binario: ' + num.toString(2);
    }

    // Simplificación booleana (ejemplo didáctico)
    function simplificar() {
      var resultado = document.getElementById('resultadoSimplificacion');
      resultado.textContent = 'A + A·B = A  (Ley de absorción)';
    }

    // Calificador de cuestionarios
    function calificar(formId, resultadoId, totalPreguntas) {
      var form = document.getElementById(formId);
      var inputs = form.querySelectorAll('input[type="radio"]:checked');
      var aciertos = 0;
      inputs.forEach(function(input) {
        if (input.value === 'correcto') {
          aciertos++;
        }
      });
      var resultado = document.getElementById(resultadoId);
      resultado.textContent = 'Has acertado ' + aciertos + ' de ' + totalPreguntas + ' preguntas.';
      if (aciertos === totalPreguntas) {
        resultado.textContent += ' ¡Perfecto! 🎉';
      } else if (aciertos >= totalPreguntas / 2) {
        resultado.textContent += ' ¡Bien!';
      } else {
        resultado.textContent += ' Sigue practicando.';
      }
    }

    // (Opcional) Expandir la primera unidad al cargar para mostrar contenido
    window.addEventListener('DOMContentLoaded', function() {
      var primeraUnidad = document.querySelector('.unidad h2');
      if (primeraUnidad) {
        toggle(primeraUnidad);
      }
    });
  </script>
</body>
</html>
